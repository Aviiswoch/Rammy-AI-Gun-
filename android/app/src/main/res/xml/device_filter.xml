<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android's attach filter only sees device-level descriptors. UVC is commonly exposed as
        direct video class 14, IAD composite class 239/2/1, or per-interface class on a class-0
        composite device. Runtime code always re-checks for an actual class-14 video interface.
    -->
    <usb-device class="14" />
    <usb-device class="239" subclass="2" protocol="1" />
    <usb-device class="0" />
</resources>
